// Anchor data for the plant's fifth segment (the top), the sprite
// plant5.png.
//
// Every point is in the segment image's own pixel space: (0, 0) at the
// upper-left, x right, y down — the same convention the anchor notes in
// examples/shapes/README.md give, the y flip to node space being the
// loader's job.
//
// A segment is attached by landing its lower_anchor exactly on the
// previous segment's upper_anchor — the two picks need not be equal
// numbers, each belongs to its own image.
(
    segment: 5,
    image: "plant5.png",
    // The joint this segment attaches to the previous one through:
    // plant4's upper joint.
    lower_anchor: (
        123.6,
        178.8,
    ),
    // The top of the chain: no segment attaches here — the joint ends
    // the stem (it still caps the top segment's midpoint, which the
    // wasps orbit).
    upper_anchor: (
        124.0,
        80.0,
    ),
    // The top slice bears no flowers.
    flower_anchors: [],
)
